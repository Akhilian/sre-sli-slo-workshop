{
  "uid": "docshare-slo-overview",
  "title": "DocShare · Vue d'ensemble des SLO",
  "description": "Burn rate, budget et alertes de tous les SLO de toutes les équipes.",
  "tags": [
    "docshare"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Équipe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:objective:ratio, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(slo:objective:ratio, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Burn rate sur 1 h",
      "description": "1 = budget épuisé en 30 jours pile. Orange au-delà de 6, rouge au-delà de 14,4 (seuils des alertes page). Cliquer une case pour le détail.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, sloth_id) (slo:sli_error:ratio_rate1h{namespace=~\"$namespace\"}) / on (namespace, sloth_id) max by (namespace, sloth_id) (slo:error_budget:ratio{namespace=~\"$namespace\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "—",
          "links": [
            {
              "title": "Détail de ce SLO",
              "url": "/d/docshare-burn-rate?var-namespace=${__data.fields.Équipe}&var-slo=docshare-${__field.name}&${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Équipe"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "links",
                "value": []
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "sloth_id",
            "rowField": "namespace",
            "valueField": "Value"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^docshare-(.*)$",
            "renamePattern": "$1"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace\\sloth_id": "Équipe"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Équipe"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Budget restant (30 j)",
      "description": "Part du budget mensuel encore disponible, sur la plage affichée ; la période non observée est supposée parfaite.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(1 - (sum by (namespace, sloth_id) (sum_over_time(slo:sli_error:ratio_rate5m{namespace=~\"$namespace\"}[$__range])) * 15) / on (namespace, sloth_id) (max by (namespace, sloth_id) (slo:error_budget:ratio{namespace=~\"$namespace\"}) * 30 * 86400), 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "—",
          "links": [
            {
              "title": "Détail de ce SLO",
              "url": "/d/docshare-burn-rate?var-namespace=${__data.fields.Équipe}&var-slo=docshare-${__field.name}&${__url_time_range}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Équipe"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "links",
                "value": []
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "sloth_id",
            "rowField": "namespace",
            "valueField": "Value"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^docshare-(.*)$",
            "renamePattern": "$1"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "namespace\\sloth_id": "Équipe"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Équipe"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Burn rate sur 1 h, par équipe et SLO",
      "description": "Le moment où chaque panne commence à consommer du budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, sloth_id) (slo:sli_error:ratio_rate1h{namespace=~\"$namespace\"}) / on (namespace, sloth_id) max by (namespace, sloth_id) (slo:error_budget:ratio{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} · {{sloth_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Alertes actives",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{namespace=~\"$namespace\",alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune alerte"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "sloth_id": true
            },
            "indexByName": {
              "namespace": 0,
              "severity": 1,
              "alertname": 2
            },
            "renameByName": {
              "namespace": "Équipe",
              "alertname": "Alerte",
              "severity": "Sévérité",
              "sloth_service": "Service",
              "sloth_slo": "SLO"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Équipe"
              }
            ]
          }
        }
      ],
      "id": 4
    }
  ]
}
